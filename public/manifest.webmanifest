{
  "name": "Habit Garden",
  "short_name": "HabitGarden",
  "description": "Grow good habits every day. Water your plants, track streaks, and level up your garden.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#10b981",
  "id": "/",

  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ],

  "shortcuts": [
    {
      "name": "Open Garden",
      "short_name": "Garden",
      "description": "Go directly to your plant dashboard",
      "url": "/#garden",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Habits",
      "short_name": "Habits",
      "description": "Open the habits list",
      "url": "/#habits",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],

  "permissions": ["notifications"],

  "gcm_sender_id": "103953800507"
}